# ==============================================================
# TripAI Server Configuration
# Copy this file to .env (inside the server/ directory):
#   cp .env.example .env
# ==============================================================

# [REQUIRED] Server Port (Default: 5000)
PORT=5000

# [REQUIRED] Node Environment (development | production)
NODE_ENV=development

# [REQUIRED FOR PRODUCTION] JWT Secret Key for user authentication tokens
# In production, replace with a secure, random string (e.g. openssl rand -base64 32)
JWT_SECRET=tripai_super_secret_jwt_key_2026_production_grade

# [OPTIONAL] MongoDB Connection URI
# Default: mongodb://127.0.0.1:27017/tripai
# NOTE: If MongoDB is not running locally, TripAI automatically falls back to a 
# resilient local persistent JSON store (data/db.json) so the app works out of the box!
MONGO_URI=mongodb://127.0.0.1:27017/tripai

# [OPTIONAL] Google Gemini AI API Key
# Get a free key at: https://aistudio.google.com/app/apikey
# NOTE: If left empty, TripAI seamlessly uses its built-in intelligent rule-based
# itinerary synthesizer and travel concierge engine (100% offline & demo ready).
GEMINI_API_KEY=

# [OPTIONAL] OpenWeatherMap API Key
# Get a free key at: https://openweathermap.org/api
# NOTE: If left empty, TripAI automatically provides seasonal climate estimates
# with clearly labeled demo indicators.
OPENWEATHER_API_KEY=

# [OPTIONAL] Unsplash API Access Key
# Get a free key at: https://unsplash.com/developers
# NOTE: If left empty, TripAI uses curated, high-resolution travel photography.
UNSPLASH_ACCESS_KEY=
